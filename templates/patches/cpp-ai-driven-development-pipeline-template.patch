+name: Automation documentation pull request
+on:
+  workflow_dispatch:
+    inputs:
+      mode:
+        description: Choose create-pr to request a documentation update.
+        type: choice
+        default: checks
+        options: [checks, create-pr]
+      description:
+        description: Documentation text to append to docs/automation.md.
+        type: string
+        default: Automated documentation update.
+permissions:
+  contents: read
+concurrency:
+  group: automation-documentation-pr
+  cancel-in-progress: false
+jobs:
+  update:
+    if: >-
+      inputs.mode == 'create-pr' &&
+      github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    permissions:
+      contents: write
+      pull-requests: write
+      actions: write
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          persist-credentials: false
+      - uses: link-foundation/.github/actions/resolve-github-token@main
+        id: gh
+        with:
+          app-id: ${{ vars.AUTOMATION_APP_ID }}
+          app-private-key: ${{ secrets.AUTOMATION_APP_PRIVATE_KEY }}
+          token: ${{ secrets.AUTOMATION_TOKEN }}
+          default-token: ${{ github.token }}
+      - name: Prepare documentation update
+        env:
+          DESCRIPTION: ${{ inputs.description }}
+        run: |
+          python3 - <<'PY'
+          import os
+          from pathlib import Path
+          path = Path('docs/automation.md')
+          path.parent.mkdir(parents=True, exist_ok=True)
+          with path.open('a') as stream:
+              stream.write(os.environ['DESCRIPTION'] + '\n')
+          PY
+      - uses: peter-evans/create-pull-request@v8
+        id: pr
+        with:
+          token: ${{ steps.gh.outputs.token }}
+          branch: automation/documentation
+          title: 'docs: automation update'
+          commit-message: 'docs: automation update'
+      - uses: link-foundation/.github/actions/dispatch-checks@main
+        if: steps.pr.outputs.pull-request-number != ''
+        with:
+          ref: ${{ steps.pr.outputs.pull-request-branch }}
+          workflows: release.yml
+          token: ${{ steps.gh.outputs.token }}
+          triggers-workflows: ${{ steps.gh.outputs.triggers-workflows }}
